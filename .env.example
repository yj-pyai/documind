# DocuMind Environment Configuration
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for development, PostgreSQL for production)
# Dev:
DATABASE_URL=sqlite+aiosqlite:///./documind.db
# Prod:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/documind

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-to-a-random-secret-key

# DeepSeek API (get your key at https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
